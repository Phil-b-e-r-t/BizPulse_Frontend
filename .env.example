# Base URL of the BizPulse backend, including the /api/v1 prefix.
# The backend must list this app's URL in its CORS_ORIGINS (default http://localhost:5173).
# In production serve the app and API on the same site (app.example.com and api.example.com)
# so the refresh-token cookie is sent. See docs/API_CHANGELOG.md in the backend repo.
VITE_API_URL=https://bizpulse-backend-gfxd.onrender.com

# Set to true ONLY to run against built-in sample data (no backend). A banner is shown while on.
VITE_USE_MOCKS=true
