# Base URL of the BizPulse backend, including the /api/v1 prefix.
VITE_API_URL=http://localhost:5000/api/v1

# OPTIONAL. Only set if your backend has a refresh-token endpoint.
# Path relative to VITE_API_URL. The client POSTs { refreshToken } and expects { token, refreshToken? }.
# Leave empty to disable refresh (the documented behaviour: expired token -> back to login).
VITE_AUTH_REFRESH_PATH=

# Set to true ONLY to run against built-in sample data (no backend). A banner is shown while on.
VITE_USE_MOCKS=false
